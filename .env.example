# Puerto del servicio OCR
PORT=8001

# Moondream (moondream==0.0.5): una de estas rutas — si no hay API key ni path, se descarga ONNX desde Hugging Face.
# MOONDREAM_API_KEY=
# Ruta a .mf o .mf.gz (ver METADATA del paquete moondream en PyPI)
# MOONDREAM_MODEL_PATH=/ruta/moondream-2b-int8.mf.gz
# Variante al descargar (compose usa 2b por defecto): 2b | 0.5b
# MOONDREAM_ONNX_VARIANT=2b
# Si cambias de variante, no fijes MOONDREAM_HF_FILENAME al .mf de otra talla, o bórralo del .env
# MOONDREAM_HF_FILENAME=moondream-2b-int8.mf.gz
# Opciones avanzadas de descarga HF:
# MOONDREAM_HF_REPO=vikhyatk/moondream2
# MOONDREAM_HF_REVISION=9dddae84d54db4ac56fe37817aeaeb502ed083e2

# Prompt del modelo: transcribe (recomendado) | legacy (TOTAL:/DATE: antiguo)
# OCR_VLM_PROMPT_MODE=transcribe

# Tesseract (OCR híbrido con Moondream); idiomas instalados en Docker: spa+eng
# OCR_TESSERACT_LANG=spa+eng
# OCR_TESSERACT_CONFIG=--psm 6
